{
  "name": "@galaui/react",
  "version": "0.1.3",
  "description": "Modern Base UI & Tailwind CSS v4 Component Library and Design Tokens",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve": "python3 -m http.server 4311 --directory .",
    "dev": "vite",
    "build": "npm run build:lib",
    "build:docs": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:app": "vite build",
    "deploy:docs": "npm run build:docs && wrangler pages deploy dist-app --project-name=galaui",
    "deploy:worker": "npm run build:docs && wrangler deploy",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview"
  },
  "keywords": [
    "design-system",
    "base-ui",
    "tailwind",
    "tailwindcss",
    "react",
    "ui",
    "components",
    "ui-kit"
  ],
  "author": "GalaUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianprata/galaui.git"
  },
  "homepage": "https://github.com/dianprata/galaui#readme",
  "bugs": {
    "url": "https://github.com/dianprata/galaui/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.40.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wouter": "^3.10.0",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
